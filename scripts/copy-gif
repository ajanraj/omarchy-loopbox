#!/usr/bin/env bash

set -euo pipefail

readonly download_max_bytes=$((15 * 1024 * 1024))
readonly cache_max_bytes=$((150 * 1024 * 1024))
readonly max_files=20
readonly default_clipboard_helper=/usr/share/omarchy/bin/omarchy-clipboard-paste-file
readonly script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
readonly media_url="$script_dir/media-url"
readonly media_download="$script_dir/media-download"

die() {
    printf 'copy-gif: error: %s\n' "$*" >&2
    exit 1
}

if (($# != 3)); then
    die "usage: $0 <url> <provider> <id>"
fi

url=$1
provider=$2
gif_id=$3

[[ "$provider" == 'klipy' ]] || die "unsupported provider '$provider'; only klipy GIFs can be copied"
if ! "$media_url" validate "$url"; then
    die 'unsafe KLIPY media URL; use an original https://static.klipy.com/...gif URL'
fi

validate_segment() {
    local kind=$1
    local value=$2

    if [[ ! "$value" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ || "$value" == '.' || "$value" == '..' ]]; then
        die "unsafe $kind segment; use only letters, digits, dot, underscore, or hyphen"
    fi
}

validate_segment provider "$provider"
validate_segment id "$gif_id"

cache_root=${XDG_CACHE_HOME:-${HOME:+$HOME/.cache}}
[[ -n "$cache_root" ]] || die 'XDG_CACHE_HOME or HOME must be set so the GIF can be cached'

cache_dir="$cache_root/loopbox/gifs"
target="$cache_dir/$provider-$gif_id.gif"
clipboard_target="$cache_dir/$provider-$gif_id.png"

if ! mkdir -p -- "$cache_dir"; then
    die 'cannot create the GIF cache directory; check its parent permissions'
fi

tmp_file=''
lock_fd=''
lock_dir=''
lock_held=0

cleanup() {
    local exit_status=$?

    if [[ -n "$tmp_file" && -e "$tmp_file" ]]; then
        rm -f -- "$tmp_file" || true
    fi
    release_lock || true

    return "$exit_status"
}
trap cleanup EXIT

release_lock() {
    if [[ -n "$lock_fd" ]]; then
        flock -u "$lock_fd" || return 1
        exec {lock_fd}>&-
        lock_fd=''
    fi
    if ((lock_held)); then
        rmdir -- "$lock_dir" 2>/dev/null || return 1
        lock_held=0
    fi
}

# flock is part of the normal Linux userspace. The mkdir fallback keeps two
# helper processes from pruning one another's current files on minimal hosts.
if command -v flock >/dev/null 2>&1; then
    # Lock the cache directory itself. Opening a predictable lock file with
    # truncation would follow an attacker-controlled symlink.
    if ! exec {lock_fd}<"$cache_dir"; then
        die 'cannot open the GIF cache lock; check its directory permissions'
    fi
    if ! flock -n "$lock_fd"; then
        die 'GIF cache is busy; retry the copy after the other operation finishes'
    fi
else
    lock_dir="$cache_dir/.copy-gif.lockdir"
    if ! mkdir -- "$lock_dir" 2>/dev/null; then
        die 'GIF cache is busy; retry the copy after the other operation finishes'
    fi
    lock_held=1
fi

validate_gif() {
    local file=$1
    local label=$2
    local size
    local magic

    if [[ ! -f "$file" || -L "$file" ]]; then
        validation_error="$label file is not a regular file"
        return 1
    fi

    if ! size=$(wc -c <"$file"); then
        validation_error="cannot read the $label GIF"
        return 1
    fi
    size=${size//[[:space:]]/}
    if [[ ! "$size" =~ ^[0-9]+$ ]] || ((size == 0)); then
        validation_error="$label file is empty"
        return 1
    fi
    if ((size > download_max_bytes)); then
        validation_error="$label file exceeds the 15 MiB download limit"
        return 1
    fi

    if ! magic=$(head -c 6 -- "$file" 2>/dev/null); then
        validation_error="cannot inspect the $label GIF"
        return 1
    fi
    if [[ "$magic" != 'GIF87a' && "$magic" != 'GIF89a' ]]; then
        validation_error="$label file is not a GIF; expected GIF87a or GIF89a magic"
        return 1
    fi

    validation_error=''
    return 0
}

validate_apng() {
    local file=$1
    local label=$2
    local signature

    if [[ ! -f "$file" || -L "$file" ]]; then
        validation_error="$label file is not a regular file"
        return 1
    fi

    if ! signature=$(head -c 8 -- "$file" 2>/dev/null | od -An -tx1 | tr -d '[:space:]'); then
        validation_error="cannot inspect the $label animated PNG"
        return 1
    fi
    if [[ "$signature" != '89504e470d0a1a0a' ]]; then
        validation_error="$label file is not a PNG"
        return 1
    fi
    if ! LC_ALL=C grep -a -m1 -q 'acTL' -- "$file"; then
        validation_error="$label PNG is not animated"
        return 1
    fi

    validation_error=''
    return 0
}

if [[ -e "$target" || -L "$target" ]]; then
    # A corrupt cache entry should heal on retry instead of poisoning this ID.
    if ! validate_gif "$target" cached; then
        if ! rm -f -- "$target"; then
            die "$validation_error and could not be removed; check cache permissions"
        fi
    fi
fi

if [[ ! -e "$target" ]]; then
    "$media_download" "$url" "$target" \
        || die 'download failed; check the URL, network connection, and provider response'
fi

if [[ -e "$clipboard_target" || -L "$clipboard_target" ]]; then
    if ! validate_apng "$clipboard_target" cached; then
        if ! rm -f -- "$clipboard_target"; then
            die "$validation_error and could not be removed; check cache permissions"
        fi
    fi
fi

if [[ ! -e "$clipboard_target" ]]; then
    command -v ffmpeg >/dev/null 2>&1 || die 'ffmpeg is required to prepare animated GIFs for compatible clipboard paste'

    if ! tmp_file=$(mktemp "$cache_dir/.copy-gif.XXXXXX.png"); then
        die 'cannot create a temporary animated PNG in the cache directory; check its permissions'
    fi
    # Level 1 with no PNG filtering keeps first-copy latency near one second
    # without the roughly 10x size increase produced by level 0.
    if ! timeout 20s ffmpeg -hide_banner -loglevel error -nostdin -y -i "$target" \
        -plays 0 -compression_level 1 -pred none -f apng "$tmp_file"; then
        die 'GIF conversion failed or timed out; retry or choose a smaller GIF'
    fi
    if ! validate_apng "$tmp_file" converted; then
        die "$validation_error; retry or choose another GIF"
    fi
    if ! mv -f -- "$tmp_file" "$clipboard_target"; then
        die 'cannot atomically cache the animated PNG; check cache permissions and retry'
    fi
    tmp_file=''
fi

# Treat the result just copied as the newest cache entry before pruning.
touch -m -- "$target" "$clipboard_target" || die 'cannot update the cached GIF timestamp; check cache permissions'

prune_cache() {
    local -a entries=()
    local entry
    local file
    local companion
    local companion_size
    local size
    local total=0
    local count=0

    mapfile -d '' entries < <(find "$cache_dir" -maxdepth 1 -type f -name '*.gif' -printf '%T@ %p\0' | sort -z -n)

    for entry in "${entries[@]}"; do
        file=${entry#* }
        [[ -f "$file" && ! -L "$file" ]] || continue
        if ! size=$(wc -c <"$file"); then
            die 'cannot inspect a cached GIF while pruning; retry the copy'
        fi
        size=${size//[[:space:]]/}
        [[ "$size" =~ ^[0-9]+$ ]] || die 'cached GIF size is unreadable; retry the copy'
        companion=${file%.gif}.png
        if [[ -f "$companion" && ! -L "$companion" ]]; then
            if ! companion_size=$(wc -c <"$companion"); then
                die 'cannot inspect a cached animated PNG while pruning; retry the copy'
            fi
            companion_size=${companion_size//[[:space:]]/}
            [[ "$companion_size" =~ ^[0-9]+$ ]] || die 'cached animated PNG size is unreadable; retry the copy'
            size=$((size + companion_size))
        fi
        count=$((count + 1))
        total=$((total + size))
    done

    if ((count <= max_files && total <= cache_max_bytes)); then
        return
    fi

    for entry in "${entries[@]}"; do
        ((count > max_files || total > cache_max_bytes)) || break
        file=${entry#* }
        [[ "$file" == "$target" ]] && continue
        [[ -f "$file" && ! -L "$file" ]] || continue

        if ! size=$(wc -c <"$file"); then
            die 'cannot inspect a cached GIF while pruning; retry the copy'
        fi
        size=${size//[[:space:]]/}
        [[ "$size" =~ ^[0-9]+$ ]] || die 'cached GIF size is unreadable; retry the copy'
        companion=${file%.gif}.png
        if [[ -f "$companion" && ! -L "$companion" ]]; then
            if ! companion_size=$(wc -c <"$companion"); then
                die 'cannot inspect a cached animated PNG while pruning; retry the copy'
            fi
            companion_size=${companion_size//[[:space:]]/}
            [[ "$companion_size" =~ ^[0-9]+$ ]] || die 'cached animated PNG size is unreadable; retry the copy'
            size=$((size + companion_size))
        fi
        if ! rm -f -- "$file"; then
            die 'cannot prune an old cached GIF; check cache permissions and retry'
        fi
        if [[ -e "$companion" || -L "$companion" ]]; then
            if ! rm -f -- "$companion"; then
                die 'cannot prune an old cached animated PNG; check cache permissions and retry'
            fi
        fi
        count=$((count - 1))
        total=$((total - size))
    done

    if ((count > max_files || total > cache_max_bytes)); then
        die 'GIF cache remains over its size limit because the current file must be retained'
    fi
}

prune_cache

# wl-copy daemonizes. Release first so its clipboard owner cannot inherit and
# retain the cache lock for the lifetime of the clipboard contents.
release_lock || die 'cannot release the GIF cache lock; retry the copy'

clipboard_helper=${LOOPBOX_CLIPBOARD_HELPER:-$default_clipboard_helper}
if [[ ! -x "$clipboard_helper" ]]; then
    die 'clipboard helper is unavailable; install Omarchy or set LOOPBOX_CLIPBOARD_HELPER to an executable helper'
fi

if ! "$clipboard_helper" --copy-only image/png "$clipboard_target" >/dev/null; then
    die 'clipboard copy failed; verify the Wayland session and clipboard helper'
fi

printf '%s\n' "$target"
